{
 "alphaforge-lambda": {
  "Version": "2012-10-17",
  "Statement": [
   {
    "Sid": "BedrockSonnet55ParProfilInferenceGlobal",
    "Effect": "Allow",
    "Action": "bedrock:InvokeModel",
    "Resource": [
     "arn:aws:bedrock:us-east-1:*:inference-profile/global.anthropic.claude-sonnet-5-5",
     "arn:aws:bedrock:us-east-1::foundation-model/anthropic.claude-sonnet-5-5",
     "arn:aws:bedrock:::foundation-model/anthropic.claude-sonnet-5-5"
    ]
   },
   {
    "Sid": "GuardrailDuProjet",
    "Effect": "Allow",
    "Action": "bedrock:ApplyGuardrail",
    "Resource": "arn:aws:bedrock:us-east-1:908027376963:guardrail/4j1tyv0fqmto"
   },
   {
    "Sid": "JournauxCloudWatch",
    "Effect": "Allow",
    "Action": [
     "logs:CreateLogGroup",
     "logs:CreateLogStream",
     "logs:PutLogEvents"
    ],
    "Resource": "*"
   },
   {
    "Sid": "BucketDuProjet",
    "Effect": "Allow",
    "Action": [
     "s3:GetObject",
     "s3:PutObject"
    ],
    "Resource": "arn:aws:s3:::alphaforge-908027376963/*"
   },
   {
    "Sid": "ListerLeBucketPourDistinguerUnObjetAbsent",
    "Effect": "Allow",
    "Action": "s3:ListBucket",
    "Resource": "arn:aws:s3:::alphaforge-908027376963"
   },
   {
    "Sid": "SInvoquerEnAsynchronePourLaProgression",
    "Effect": "Allow",
    "Action": "lambda:InvokeFunction",
    "Resource": "arn:aws:lambda:us-east-1:*:function:alphaforge-tribunal"
   }
  ]
 }
}
