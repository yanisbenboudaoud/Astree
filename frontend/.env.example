# Copier en « .env.local » (ignoré par Git) pour changer de mode.

# true (défaut) : rejoue les procès enregistrés dans src/data/proces/.
# false : appelle le Tribunal en direct sur AWS Lambda.
VITE_USE_MOCKS=true

# Function URL de la Lambda alphaforge-tribunal, sans « / » final (mode direct seulement).
# La Function URL doit être en type d'authentification NONE, avec CORS limité au domaine de l'interface
# (deploiement/README.md, « Point d'accès »).
VITE_API_URL=
