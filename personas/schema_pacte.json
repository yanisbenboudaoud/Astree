{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "personas/schema_pacte.json",
  "title": "Fichier profil (Pacte) d'AlphaForge AI",
  "description": "Format générique d'un fichier personas/<id>.json (CLAUDE.md, section 3). Ajouter un profil = ajouter un fichier qui respecte ce schéma, sans changer le code. Les renvois que le schéma ne peut pas exprimer (id de règles uniques, catégories existantes, poids qui totalisent 1) sont vérifiés par pipeline/pacte.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "nom", "etiquette", "profil_risque", "horizon_ans",
    "capital_fictif_cad", "portefeuille", "decision_demo", "pacte"
  ],
  "properties": {
    "id": {
      "description": "Identifiant du Pacte, repris dans le champ persona du contrat. Minuscules, chiffres et _ seulement.",
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "nom": {"type": "string", "minLength": 1},
    "age": {"type": "integer", "minimum": 18, "maximum": 120},
    "metier": {"type": "string", "minLength": 1},
    "etiquette": {
      "description": "Les profils sont des profils de test : toujours « fictif ».",
      "const": "fictif"
    },
    "profil_risque": {"type": "string", "minLength": 1},
    "horizon_ans": {
      "description": "[minimum, maximum] en années ; maximum null = sans borne (ex. : « 15 ans et plus »).",
      "type": "array",
      "prefixItems": [
        {"type": "number", "minimum": 0},
        {"type": ["number", "null"], "minimum": 0}
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "capital_fictif_cad": {"type": "number", "exclusiveMinimum": 0},
    "portefeuille": {
      "description": "Portefeuille de départ. Les poids doivent totaliser 1 (vérifié en Python).",
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/ligne"}
    },
    "decision_demo": {"$ref": "#/$defs/decision"},
    "pacte": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date_signature", "regles"],
      "properties": {
        "date_signature": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "regles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/regle"}}
      }
    }
  },

  "$defs": {
    "part": {"type": "number", "minimum": 0, "maximum": 1},

    "ligne": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ticker", "poids"],
      "properties": {
        "ticker": {"type": "string", "minLength": 1},
        "poids": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    },

    "decision": {
      "description": "Même format que decision dans le contrat (CLAUDE.md, section 5), sans libelle.",
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"enum": ["position", "reallocation"]}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "position"}}},
          "then": {
            "additionalProperties": false,
            "required": ["type", "ticker", "taille", "financement"],
            "properties": {
              "type": true,
              "ticker": {"type": "string", "minLength": 1},
              "taille": {"$ref": "#/$defs/part"},
              "financement": {"type": "string", "pattern": "^(proportionnel|depuis_.+)$"}
            }
          }
        },
        {
          "if": {"properties": {"type": {"const": "reallocation"}}},
          "then": {
            "additionalProperties": false,
            "required": ["type", "panier", "part_reallouee"],
            "properties": {
              "type": true,
              "panier": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ligne"}},
              "part_reallouee": {"$ref": "#/$defs/part"}
            }
          }
        }
      ]
    },

    "regle": {
      "description": "Règle typée du Pacte. Chaque type a ses paramètres (CLAUDE.md, section 3). Ajouter un type = une ligne dans l'enum, un bloc if/then ici, et une fonction dans le Greffier.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "libelle", "justification"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "type": {"enum": ["pire_baisse_max", "plafond", "critere_documentaire", "qualitative"]},
        "libelle": {"type": "string", "minLength": 1},
        "justification": {
          "description": "Pourquoi ce seuil : hypothèse de l'équipe ou citation de l'énoncé. Présentée comme une hypothèse.",
          "type": "string",
          "minLength": 1
        },
        "seuil": {"type": "number", "minimum": -1, "maximum": 0},
        "categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "max": {"$ref": "#/$defs/part"},
        "critere": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "pire_baisse_max"}}},
          "then": {"required": ["seuil"], "allOf": [{"not": {"required": ["categories"]}}, {"not": {"required": ["max"]}}, {"not": {"required": ["critere"]}}]}
        },
        {
          "if": {"properties": {"type": {"const": "plafond"}}},
          "then": {"required": ["categories", "max"], "allOf": [{"not": {"required": ["seuil"]}}, {"not": {"required": ["critere"]}}]}
        },
        {
          "if": {"properties": {"type": {"const": "critere_documentaire"}}},
          "then": {"required": ["critere"], "allOf": [{"not": {"required": ["seuil"]}}, {"not": {"required": ["categories"]}}, {"not": {"required": ["max"]}}]}
        },
        {
          "if": {"properties": {"type": {"const": "qualitative"}}},
          "then": {"allOf": [{"not": {"required": ["seuil"]}}, {"not": {"required": ["categories"]}}, {"not": {"required": ["max"]}}, {"not": {"required": ["critere"]}}]}
        }
      ]
    }
  }
}
